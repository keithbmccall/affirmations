{
  "name": "affirmations",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "ts": "tsc --noEmit",
    "check": "npm run ts && npm run lint && npm test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "nuke": "rm -rf node_modules .jest-cache coverage && watchman watch-del '/Users/keithmccall/WebstormProjects/affirmations' ; watchman watch-project '/Users/keithmccall/WebstormProjects/affirmations' && npm i",
    "nuke:start": "npm run nuke && npm run recharge && npm run ios",
    "nuke:full": "rm -rf ios android && npm run nuke",
    "nuke:fullstart": "npm run nuke:full && npm run recharge && npm run ios",
    "podpod": "cd ios && pod install && cd ..",
    "recharge": "npm i;npx expo install;npx expo prebuild;npm run podpod",
    "test:all": "jest --watchAll",
    "test": "jest",
    "test:coverage:lens": "jest lib/features/Lens --coverage --collectCoverageFrom='lib/features/Lens/Camera/Camera.tsx' --collectCoverageFrom='lib/features/Lens/Camera/LensCameraSurface.tsx' --collectCoverageFrom='lib/features/Lens/Obskura/ObskuraCameraSurface.tsx' --collectCoverageFrom='lib/features/Lens/Camera/hooks/useCameraFocus.ts' --collectCoverageFrom='lib/features/Lens/Camera/hooks/useCameraRoll.ts' --collectCoverageFrom='lib/features/Lens/Camera/hooks/useLensPermissions.ts' --collectCoverageFrom='lib/features/Lens/Camera/options.ts' --collectCoverageFrom='lib/features/Lens/ColorPalette/getColorLensPalette.ts' --collectCoverageFrom='lib/features/Lens/ColorPalette/getColorLensRegion.ts' --collectCoverageFrom='lib/features/Lens/ColorPalette/useColorLensPalette.ts' --collectCoverageFrom='lib/features/Lens/ColorPalette/useColorLensRegion.ts' --coverageReporters=text --coverageThreshold='{\"global\":{\"lines\":100,\"statements\":100,\"functions\":100,\"branches\":100}}'",
    "test:coverage:affirmations": "jest --testPathPattern=lib/features/Affirmations --coverage --collectCoverageFrom='lib/features/Affirmations/NotificationDetails.tsx' --collectCoverageFrom='lib/features/Affirmations/Notifications/Notifications.tsx' --collectCoverageFrom='lib/features/Affirmations/Notifications/ScheduleHistory.tsx' --collectCoverageFrom='lib/features/Affirmations/Notifications/Scheduler.tsx' --collectCoverageFrom='lib/features/Affirmations/Notifications/notificationActions.ts' --collectCoverageFrom='lib/features/Affirmations/Notifications/useNotificationsScheduler.ts' --collectCoverageFrom='lib/features/Affirmations/Notifications/workletGestures.ts' --coverageReporters=text --coverageThreshold='{\"global\":{\"lines\":100,\"statements\":100,\"functions\":100,\"branches\":100}}'",
    "version:patch": "node scripts/update-version.js patch",
    "version:minor": "node scripts/update-version.js minor",
    "version:major": "node scripts/update-version.js major",
    "preinstall": "corepack enable"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "^2.6.4",
    "expo": "^57.0.9",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-color-lens-frame-processor": "file:./modules/expo-color-lens-frame-processor",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-media-library": "~57.0.5",
    "expo-modules-core": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-resizer": "^5.2.3",
    "react-native-vision-camera-skia": "^5.2.3",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@testing-library/react-native": "13.2.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@welldone-software/why-did-you-render": "10.0.1",
    "eslint": "9.30.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "jest-watch-typeahead": "2.2.2",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "4.1.0",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "npm@10.9.2"
}
