{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["colorlens"],
  "ios": {
    "iosModuleName": "ExpoColorLensFrameProcessor"
  },
  "android": {
    "androidNamespace": ["colorlens"],
    "androidCxxLibName": "ExpoColorLensFrameProcessor"
  },
  "autolinking": {
    "ColorLensProcessor": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridColorLensProcessor"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
